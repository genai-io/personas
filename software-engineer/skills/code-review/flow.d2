direction: down

title: |md
  # code-review
  correctness + cleanup, in one pass
| {near: top-center}

scope: {
  label: "Phase 0 — Scope"
  shape: rectangle
  gather: "git diff @{upstream}...HEAD\n+ git diff HEAD if dirty\nor the target passed in"
}

find: {
  label: "Phase 1 — Find (parallel, no angle suppresses another)"
  grid-columns: 2

  correctness: {
    label: "Correctness — does it break?"
    grid-rows: 5
    a: "A · hunk + enclosing function\nlogic, nil, errors, regex metachars"
    b: "B · language pitfalls\nthe traps of this language and framework"
    c: "C · removed behavior\nwhat invariant did the deleted lines hold?"
    d: "D · cross-file\ndo callers still hold?"
    e: "E · wrappers, concurrency, resources\ndelegation, races, leaks, contracts"
  }

  cleanup: {
    label: "Cleanup — is it worth keeping?"
    grid-rows: 4
    f: "F · reuse & simplification\nexisting helper, derivable state, dead code"
    g: "G · efficiency\nwasted work, hot paths, captured scope"
    h: "H · altitude\nspecial case on shared infra = too shallow"
    i: "I · conventions\nquoted rule from the project's\ninstruction files + the line breaking it"
  }
}

verify: {
  label: "Phase 2 — Verify"
  shape: rectangle
  v: "one verifier per candidate\nagainst the actual code"

  ladder: |md
    **CONFIRMED** — names the inputs and the wrong result

    **PLAUSIBLE** — the default; realistic runtime state is not grounds to refute

    **REFUTED** — only on evidence built from the code
  |
}

sweep: {
  label: "Phase 3 — Sweep (large or risky diffs)"
  shape: rectangle
  s: "fresh reviewer holding the verified list\nlooks only for what is missing"
}

report: {
  label: "Phase 4 — Report"
  shape: rectangle
  order: "bugs first, then cleanups\ncorrectness outranks cleanup when cutting"
}

fix: {
  label: "Phase 5 — Fix (on request)"
  shape: rectangle
  how: "smallest change per confirmed finding\nskip what changes intended behavior\nor reaches outside the diff"
}

scope -> find: "the diff is the scope"
find -> verify: "candidates\n(pass anything with a nameable scenario)"
verify -> sweep: "keep CONFIRMED + PLAUSIBLE" {style.stroke-width: 3}
verify -> dropped: "drop REFUTED" {style.stroke-dash: 4}
sweep -> report
report -> fix: "--fix, or the user asks"

dropped: {
  label: "discarded"
  shape: oval
  style.opacity: 0.5
}

note: |md
  A finding with no concrete scenario is a guess.
  For a cleanup, the scenario is the **cost** —
  what is duplicated, wasted, or harder to maintain.

  No Agent tool? Work every angle inline, and say so in the report.
| {near: bottom-center}
